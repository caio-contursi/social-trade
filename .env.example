# PostgreSQL da aplicação, separado do banco exclusivo de testes. Configure a autenticação localmente.
SOCIALTRADE_DATABASE_URL=postgresql+psycopg://socialtrade@127.0.0.1:5432/socialtrade
# Opcional: schema PostgreSQL existente. Sem esta variável, usa o padrão da conexão.
# SOCIALTRADE_DATABASE_SCHEMA=public
SOCIALTRADE_TOKEN_SECRET=replace-with-a-long-random-secret
# Só sinaliza as demonstrações na interface; nunca cria ou altera contas no startup.
SOCIALTRADE_DEMO_USERS=false
# Solana Pay. Use um endpoint RPC confiável com WebSocket/HTTP e limites adequados em produção.
SOCIALTRADE_SOLANA_RPC_URL=https://api.mainnet.solana.com
